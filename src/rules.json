[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "modifyHeaders",
      "requestHeaders": [
        {
          "header": "Origin",
          "operation": "set",
          "value": "https://www.icloud.com"
        },
        {
          "header": "Referer",
          "operation": "set",
          "value": "https://www.icloud.com/"
        }
      ]
    },
    "condition": {
      "regexFilter": "^https://([a-z0-9-]+\\.)*icloud\\.com/.*$",
      "resourceTypes": ["xmlhttprequest"],
      "excludedInitiatorDomains": ["apple.com", "icloud.com"]
    }
  }
]
